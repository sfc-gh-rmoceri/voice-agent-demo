{
  "name": "voice-agent-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tts:setup": "snow sql -f sql/01_setup.sql",
    "tts:image": "./scripts/push-image.sh",
    "tts:create": "snow sql -f sql/02_service.sql",
    "tts:up": "snow sql -f sql/04_resume.sql",
    "tts:down": "snow sql -f sql/03_suspend.sql",
    "tts:status": "snow sql -q \"SHOW COMPUTE POOLS LIKE 'VOICE_TTS_POOL'; DESCRIBE SERVICE VOICE_DEMO.TTS.KOKORO_TTS\""
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^26.6.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.68.0",
    "marked": "^15.0.0",
    "mermaid": "^11.0.0",
    "vega": "^5.30.0",
    "vega-embed": "^6.26.0",
    "vega-lite": "^5.21.0"
  },
  "type": "module"
}
